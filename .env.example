# Скопируйте в .env и подставьте свои значения. Все значения ниже — вымышленные.

# Режим отладки. В продакшене держите False.
DEBUG=True

# Обязателен при DEBUG=False. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# Через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:replace-with-token-from-botfather

# Telegram ID курьера и флориста (узнать можно у @userinfobot)
COURIER_ID=111111111
FLORIST_ID=222222222

# Где хранить базу и загруженные фото (по умолчанию db.sqlite3 и media/ в корне проекта).
# В docker-compose эти пути задаются сами.
# DATABASE_PATH=/data/db.sqlite3
# MEDIA_ROOT=/data/media
# Отдавать /media/ средствами Django при DEBUG=False (для демо; в проде лучше nginx)
# SERVE_MEDIA=True

# Продакшен за HTTPS (необязательно)
# HTTPS_ONLY=True
# TRUST_PROXY_SSL_HEADER=True
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
